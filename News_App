from tkinter import *
from PIL import ImageTk, Image
import requests
from urllib.request import urlopen
import io

class NewsApp:
    global index

    def __init__(self):

        #fetch data using module requests
        self.data = requests.get(##Your Api).json()

        #initial gui load
        self.load_gui()

        #load the first news item
        self.load_news(0)

    def load_gui(self):
        self.root = Tk()
        self.root.title('khabaren')
        self.root.geometry('400x600')
        self.root.resizable(0,0)
        self.root.config(bg=('black'))

    def clear(self):
        for i in self.root.pack_slaves():
            i.destroy()

    def load_news(self,index):
        #clear the screen for new news
        self.clear()
        
        def previous_news(self):
            self.index = index
            self.index = self.index-1

        #image
        img_url = self.data['articles'][index]['urlToImage']
        response = requests.get(img_url, stream=True)
        img = Image.open(io.BytesIO(response.content)).resize((395,350))

        photo = ImageTk.PhotoImage(img)

        img_label = Label(self.root, image=photo)
        img_label.pack()

        #for heading
        heading = Label(self.root, text = self.data['articles'][index]['title'],bg='black', fg="white", wraplength=380, justify='center')
        heading.pack(pady=(10,20))
        heading.config(font=('verdana',16))

        #for details
        details = Label(self.root, text = self.data['articles'][index]['description'],bg='black', fg="white", wraplength=390, justify='center')
        details.pack(pady=(10,20))
        details.config(font=('verdana',14))

        frame = Frame(self.root, bg="black")
        frame.pack(expand=True, fill=BOTH)

        previous_btn = Button(frame, text="Previous", width=11,height=3, command=lambda: previous_news(self))
        previous_btn.pack(side=LEFT)

        read_btn = Button(frame, text="Read More", width=11,height=3)
        read_btn.pack(side=LEFT)

        next_btn = Button(frame, text="Next", width=12,height=3)
        next_btn.pack(side=RIGHT)

        

        self.root.mainloop()

obj = NewsApp()
